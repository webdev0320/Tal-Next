# Next.js frontend environment (ISR blog setup)

# Laravel admin panel API (server-side fetches)
ADMIN_API_URL=http://127.0.0.1:8000/api

# Time-based ISR fallback in seconds (the admin webhook revalidates on demand)
BLOG_REVALIDATE=60

# Shared secret for the /api/revalidate webhook. Must match FRONTEND_REVALIDATE_TOKEN
# in admin-panel/.env. Leave empty in local dev to skip the token check.
REVALIDATE_TOKEN=
